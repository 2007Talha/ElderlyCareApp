# ── Passcode Authentication ──
AUTH_PASSCODE=123456
SESSION_SECRET=change-me-to-a-random-string

# ── SMTP Email Configuration (optional – mock transport used when absent) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Notification Recipients ──
ELDERLY_EMAIL=elderly@example.com
CARETAKER_EMAIL=caretaker@example.com
FAMILY_EMAIL=family@example.com

# ── Gemini AI (optional – deterministic fallback used when absent) ──
GEMINI_API_KEY=your-gemini-api-key

# ── App Config ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
